# Port the API listens on
PORT=4000

# Postgres connection string — required, the server refuses to boot without it
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aduan

# Database for `npm test` — DROPPED AND RECREATED on every run. Must end in _test.
# Defaults to DATABASE_URL with _test appended.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aduan_test

# Max connections in the pg pool
DB_POOL_MAX=10

# Comma-separated list of frontend origins. Used for CORS AND as the CSRF
# allow-list for cookie-authenticated writes — keep it exact.
CORS_ORIGIN=http://localhost:3000

# Staff sessions
SESSION_TTL_MINUTES=480        # absolute cap: one working day
SESSION_IDLE_MINUTES=30        # signed out after this long idle
# Staff sign-in (§8 decision 14): 5 wrong passwords block the account until ADMIN
# unlocks it or the owner uses "Lupa kata laluan". Fixed by policy, not configurable.

# lax works when FE and BE share a registrable domain (incl. localhost ports).
# Set none only if they're on unrelated domains; that forces Secure (HTTPS).
COOKIE_SAMESITE=lax

# Complainant email-OTP login. Code length (6), expiry (10 min) and attempt
# limit (5) are fixed by CLAUDE.md §8 decision 4 and not configurable here.
OTP_COOLDOWN_SECONDS=60               # minimum gap between codes to one address
OTP_MAX_PER_HOUR=5                    # codes per address per rolling hour
COMPLAINANT_SESSION_TTL_MINUTES=120
COMPLAINANT_SESSION_IDLE_MINUTES=30

# Outbound email: none to configure locally — notifyByEmail() prints to this
# console. There is no SMS configuration, by design (rule 10).

# Supporting documents (§8 decision 10). Stored on this machine's disk — back
# this directory up; it holds evidence. Relative to BE/.
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_MB=10
